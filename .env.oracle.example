# Oracle Object Storage (S3-compatible)
# Get these from: Identity → Users → <your-user> → Customer Secret Keys
AWS_ACCESS_KEY_ID=<your-customer-secret-key-id>
AWS_SECRET_ACCESS_KEY=<your-customer-secret-access-key>

# Get namespace from: Profile → Tenancy → Object Storage Namespace
# Format: https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
AWS_ENDPOINT_URL=https://<tenancy-namespace>.compat.objectstorage.ap-singapore-1.oraclecloud.com

# OCI region you created the bucket in (e.g. ap-singapore-1, ap-mumbai-1, us-ashburn-1)
AWS_REGION=ap-singapore-1

# The bucket you created in Oracle Object Storage
S3_BUCKET_NAME=lead-gen-data

# Google Gemini API key (for AI config suggestions)
GOOGLE_API_KEY=<your-google-api-key>
